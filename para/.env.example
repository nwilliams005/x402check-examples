# Para Developer Portal: https://developer.getpara.com
# BETA keys work with @test.getpara.com identifiers.
PARA_API_KEY=
# BETA | PROD  (REST SDK env string)
PARA_ENVIRONMENT=BETA

# Agent wallet identifier for Para REST createWallet (EMAIL recommended for demos)
PARA_USER_IDENTIFIER=agent@test.getpara.com
PARA_USER_IDENTIFIER_TYPE=EMAIL

# Reuse an existing Para REST wallet instead of creating one
# PARA_WALLET_ID=
# PARA_WALLET_ADDRESS=

# x402check
X402CHECK_URL=https://x402check.dev
# Prefer the one free regular check (sign a challenge) before paying $0.01
USE_FREE_CHECK=1

# Seller URL the agent is about to pay (any x402 endpoint)
SELLER_URL=https://x402check.dev/example

# Base RPC used by ExactEvmScheme when settling USDC
BASE_RPC_URL=https://base-rpc.publicnode.com

# Max USD the agent will pay the seller after a passing check
MAX_AMOUNT_USD=1

# Abort on caution as well as avoid (default: only avoid)
# ABORT_ON_CAUTION=1

# ---- Dry run (no Para key, no on-chain spend) ----
# DRY_RUN=1
# DRY_RUN_VERDICT=ok|caution|avoid
# Optional fixed key for dry-run signing demos (never commit a funded key)
# DRY_RUN_PRIVATE_KEY=
