{
  "name": "x402check-crossmint-example",
  "version": "0.1.0",
  "private": true,
  "description": "Crossmint wallet agent that runs x402check before paying an x402 endpoint",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/index.ts",
    "dry-run": "DRY_RUN=1 tsx src/index.ts",
    "dry-run:avoid": "DRY_RUN=1 DRY_RUN_VERDICT=avoid tsx src/index.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@crossmint/wallets-sdk": "1.21.0",
    "@x402/core": "2.29.0",
    "@x402/evm": "2.29.0",
    "@x402/fetch": "2.29.0",
    "dotenv": "^16.4.7",
    "viem": "^2.27.0",
    "x402check-client": "^0.1.4"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3"
  }
}
