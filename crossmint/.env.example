# Crossmint Console: https://www.crossmint.com/console
CROSSMINT_API_KEY=
# Server signer secret (type: "server") — keep offline; SDK derives address locally
CROSSMINT_SERVER_SIGNER_SECRET=

# Chain for createWallet / signTypedData (base for mainnet Exact USDC)
CROSSMINT_CHAIN=base

# Reuse a deployed wallet address (recommended for live — first tx may be required before sigs)
# CROSSMINT_WALLET_ADDRESS=
# CROSSMINT_WALLET_ALIAS=

X402CHECK_URL=https://x402check.dev
USE_FREE_CHECK=1
SELLER_URL=https://x402check.dev/example
BASE_RPC_URL=https://base-rpc.publicnode.com
MAX_AMOUNT_USD=1

# DRY_RUN=1
# DRY_RUN_VERDICT=ok|caution|avoid
# DRY_RUN_PRIVATE_KEY=
