# Privy Dashboard: https://dashboard.privy.io
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Reuse an existing server wallet (skip wallets.create)
# PRIVY_WALLET_ID=
# PRIVY_WALLET_ADDRESS=

# For EIP-7702 gas-sponsored wallets: erc1271 (optional)
# PRIVY_SIGNATURE_TYPE=erc1271

# x402check
X402CHECK_URL=https://x402check.dev
USE_FREE_CHECK=1

SELLER_URL=https://x402check.dev/example
BASE_RPC_URL=https://base-rpc.publicnode.com
MAX_AMOUNT_USD=1
# ABORT_ON_CAUTION=1

# ---- Dry run (no Privy keys, no on-chain spend) ----
# DRY_RUN=1
# DRY_RUN_VERDICT=ok|caution|avoid
# DRY_RUN_PRIVATE_KEY=
